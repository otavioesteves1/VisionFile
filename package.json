{
  "name": "visionfile",
  "version": "7.2.0",
  "description": "VisionFile — Monitor de arquivos em tempo real",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "author": "Otavio",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.otavio.visionfile",
    "productName": "VisionFile",
    "directories": { "output": "dist" },
    "win": {
      "icon": "assets/icone.png",
      "target": [{ "target": "portable", "arch": ["x64"] }]
    }
  }
}
